<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_amoled_background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textSize="20sp"
        android:textColor="?attr/primaryColor"
        android:text="Set Master Pattern" />

    <TextView
        android:id="@+id/tvPatternInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="16sp"
        android:textColor="?attr/primaryColorTrans70"
        android:text="Connect at least 4 dots to draw your master pattern." />

    <app.olauncher.ui.vault.PatternLockView
        android:id="@+id/setPatternLockView"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnResetPattern"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="Reset"
            android:textColor="?attr/primaryColorTrans70" />

        <Button
            android:id="@+id/btnCancelPattern"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="Cancel"
            android:textColor="?attr/primaryColorTrans70" />
    </LinearLayout>

</LinearLayout>